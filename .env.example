# ==============================================================================
# RAG-Powered Document Assistant - Environment Configuration
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development

# Backend Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_BASE_URL=http://localhost:8000

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["http://localhost:8501", "http://127.0.0.1:8501"]

# ChromaDB Vector Store Configuration
CHROMA_PERSIST_DIR=./backend/data/vector_store
CHROMA_COLLECTION_NAME=cs_documents

# Embeddings Model (HuggingFace Sentence-Transformers)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Ollama LLM Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=60.0

# Retrieval Parameters
TOP_K=4
